# Supabase → Project Settings → API
# Copy this file to .env.local and fill in the values there.
# .env.local is gitignored; THIS file is committed, so keep it empty.
# Both names are accepted; `PUBLISHABLE` is the current one, `ANON` is legacy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never commit a service_role / secret key, and never prefix one with NEXT_PUBLIC_.

# OpenRouter → https://openrouter.ai/settings/keys
# Powers the Ai Report tab. Server-side only: no NEXT_PUBLIC_ prefix, so the key
# never reaches the browser.
OPENROUTER_API_KEY=

# Optional. Defaults to google/gemma-4-31b-it:free.
OPENROUTER_MODEL=

# Optional. Comma-separated models to route to when the one above is busy —
# free models share one upstream pool and spend hours returning 429. The report
# names whichever model answered. Set this empty to insist on the primary.
OPENROUTER_FALLBACKS=
